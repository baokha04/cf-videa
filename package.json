{
  "name": "cf-videa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quản lý tài khoản + kho ý tưởng short video trên Cloudflare Pages, D1 và Vectorize",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy",
    "deploy:preview": "wrangler pages deploy --branch=dev",
    "types": "wrangler types --env-interface Env ./src/env.d.ts",
    "tail": "wrangler pages deployment tail",
    "db:local": "wrangler d1 execute videa-db --local --file=./migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute videa-db --remote --file=./migrations/0001_init.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "bash scripts/smoke.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260901.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.127.1"
  }
}
